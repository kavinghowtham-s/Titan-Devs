# Environment Configuration — OpsPilot AI (Trentar Pvt Ltd)

# Application Environment
APP_ENV=development
DEBUG=true
PORT=8000
HOST=127.0.0.1
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database (SQLite with WAL mode)
DATABASE_URL=sqlite:///./trentar_ops.db
SQLITE_WAL_MODE=true

# LLM Configuration (Ollama Cloud API)
# Set LLM_MOCK=false to activate live cloud inference once OLLAMA_API_KEY is present
LLM_MOCK=false
OLLAMA_BASE_URL=https://ollama.com
OLLAMA_API_KEY=

# Per-Role Model Routing (Selected from verified active models on https://ollama.com)
# Classifier & Entity Extraction
MODEL_INTAKE=deepseek-v4.1-flash
# Contextual Response Drafter (Multilingual English/Tamil/Hindi)
MODEL_DRAFTER=deepseek-v4.1-flash
# Autonomous Compliance & Safety Guardian (E1)
MODEL_ORCHESTRATOR=deepseek-v4.1-flash
# Safe Read-Only SQL Generator (E3)
MODEL_SQL=kimi-k2.7-code
# Executive Demand & P&L Insights Writer (E4)
MODEL_INSIGHTS=deepseek-v4.1-flash

# Autonomous Auto-Approval Scheduler (E1)
# 360 minutes = 6 hours for production; set to 1 for live hackathon presentation
AUTO_APPROVE_DELAY_MINUTES=1
SCHEDULER_INTERVAL_SECONDS=15

# Sender Identification for Outbound Customer Replies
SENDER_NAME="Rajesh Kumar"
SENDER_TITLE="Operations Manager"
SENDER_COMPANY="Trentar Private Limited"
SENDER_EMAIL="operations@trentar.com"
